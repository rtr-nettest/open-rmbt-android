<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="at.specure.data.entity.History" />

        <import type="at.specure.data.Classification" />

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/padding_large"
        android:paddingBottom="@dimen/padding_large">

        <ImageView
            android:id="@+id/imageSignal"
            android:layout_width="@dimen/history_image_size"
            android:layout_height="@dimen/history_image_size"
            android:contentDescription="@string/coverage_result"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_upload_enabled"
            app:tint="@color/navigation_gray" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/RobotoRegularStyle.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:textColor="@color/text_dark_gray"
            app:historyTime="@{item.time}"
            app:historyTimezone="@{item.timezone}"
            tools:text="20.11.18, 12:00:45" />


        <!-- Weight 3 after the date's weight 2 puts the left edge at 2/5 of the row, i.e. exactly the
             "Down" column where the speed rows show their first value - so "N Points" lines up with it. -->
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/RobotoBoldStyle.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="start|center_vertical"
            android:text='@{item.fencesCount + " " + @string/points}'
            android:contentDescription="@{@string/number_of_fences_is + ' ' + item.fencesCount}"
            android:textColor="@color/text_dark_gray"
            tools:text="238 Points" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</layout>