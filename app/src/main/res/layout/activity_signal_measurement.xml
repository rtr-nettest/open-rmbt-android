<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="isActive"
            type="Boolean" />

        <variable
            name="isPaused"
            type="Boolean" />

        <variable
            name="state"
            type="at.rtr.rmbt.android.ui.viewstate.HomeViewState" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true">

        <androidx.fragment.app.FragmentContainerView
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:padding="@dimen/margin_medium"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/measurementInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="10dp"
                android:layout_marginTop="@dimen/coverage_result_margin_top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/measurementResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:padding="@dimen/margin_medium">

                    <TextView
                        android:id="@+id/result_title"
                        style="@style/RobotoMediumStyle.ExtraLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/signal_result_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/result_time"
                        style="@style/RobotoMediumStyle.ExtraLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:timeString="@{state.coverageSessionStart}"
                        tools:text="20.11.18, 12:00:45"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/result_title" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/measurementProgressInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_medium">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline_column_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.33"/>

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline_column_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.66"/>

                    <!-- Technology -->
                    <TextView
                        android:id="@+id/technology_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/network_label"
                        android:gravity="start"
                        style="@style/RobotoBoldStyle.Medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/guideline_column_1"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/technology_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_tech_color"
                        android:paddingHorizontal="@dimen/padding_medium_large"
                        android:paddingVertical="@dimen/padding_small"
                        tools:text="5G"
                        style="@style/RobotoBoldStyle.Medium"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="@id/technology_label"
                        app:layout_constraintEnd_toEndOf="@id/technology_label"
                        app:layout_constraintTop_toBottomOf="@id/technology_label"/>

                    <!-- Ping -->
                    <TextView
                        android:id="@+id/ping_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ping"
                        android:gravity="center_horizontal"
                        style="@style/RobotoBoldStyle.Medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/guideline_column_1"
                        app:layout_constraintEnd_toStartOf="@id/guideline_column_2"/>

                    <TextView
                        android:id="@+id/ping_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        tools:text="10 ms"
                        style="@style/RobotoBoldStyle.Medium"
                        app:layout_constraintTop_toTopOf="@id/technology_value"
                        app:layout_constraintBottom_toBottomOf="@id/technology_value"
                        app:layout_constraintStart_toStartOf="@id/ping_label"
                        app:layout_constraintEnd_toEndOf="@id/ping_label"/>

                    <!-- Accuracy -->
                    <TextView
                        android:id="@+id/accuracy_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/location_dialog_label_accuracy"
                        android:gravity="end"
                        style="@style/RobotoBoldStyle.Medium"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/guideline_column_2"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/accuracy_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        tools:text="19.6m"
                        style="@style/RobotoBoldStyle.Medium"
                        app:layout_constraintTop_toTopOf="@id/technology_value"
                        app:layout_constraintBottom_toBottomOf="@id/technology_value"
                        app:layout_constraintStart_toStartOf="@id/accuracy_label"
                        app:layout_constraintEnd_toEndOf="@id/accuracy_label"/>

                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/row_1_bottom_barrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="technology_value,ping_value,accuracy_value"/>

                    <!-- Signal -->
                    <TextView
                        android:id="@+id/signal_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        android:translationY="10dp"
                        android:gravity="center_horizontal"
                        android:text="@string/label_signal_strength"
                        style="@style/RobotoBoldStyle.Medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/row_1_bottom_barrier"/>

                    <TextView
                        android:id="@+id/signal_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:translationY="10dp"
                        tools:text="-85 dBm"
                        style="@style/RobotoBoldStyle.Medium"
                        app:layout_constraintStart_toStartOf="@id/signal_label"
                        app:layout_constraintTop_toBottomOf="@id/signal_label"/>

                    <at.rtr.rmbt.android.ui.view.SignalLevelBarsView
                        android:id="@+id/signal_bars_indicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:translationX="10dp"
                        android:translationY="10dp"
                        app:layout_constraintStart_toEndOf="@id/signal_value"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/signal_value"
                        app:layout_constraintBottom_toBottomOf="@id/signal_value"/>

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/measurementProgressInfoPipNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="10dp"
                android:layout_marginTop="@dimen/margin_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_medium">

                    <!-- Technology -->
                    <TextView
                        android:id="@+id/technology_label_pip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/network_label"
                        style="@style/RobotoBoldStyle.Small"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/technology_value_pip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="5G"
                        style="@style/RobotoBoldStyle.Small"
                        app:layout_constraintStart_toStartOf="@id/technology_label_pip"
                        app:layout_constraintTop_toBottomOf="@id/technology_label_pip"/>

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/measurementProgressInfoPipPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="10dp"
                android:layout_marginTop="@dimen/margin_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_medium">

                    <!-- Ping -->
                    <TextView
                        android:id="@+id/ping_label_pip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ping"
                        style="@style/RobotoBoldStyle.Small"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/ping_value_pip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="10 ms"
                        style="@style/RobotoBoldStyle.Small"
                        app:layout_constraintTop_toBottomOf="@id/ping_label_pip"
                        app:layout_constraintStart_toStartOf="@id/ping_label_pip" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/buttonStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{!isActive}"
                android:text="Start"
                app:layout_constraintEnd_toStartOf="@+id/buttonStop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/buttonStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{isActive}"
                android:text="Stop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/buttonStart"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/buttonPause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{!isPaused &amp;&amp; isActive}"
                android:text="Pause"
                app:layout_constraintEnd_toStartOf="@+id/buttonResume"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonStart"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/buttonResume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:enabled="@{isPaused &amp;&amp; isActive}"
                android:text="Resume"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/buttonPause"
                app:layout_constraintTop_toBottomOf="@+id/buttonStop"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/buttonWipe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Wipe all data"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonPause"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/labelActive"
                style="@style/TextInputTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="isActive: "
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonWipe"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/textActive"
                style="@style/TextInputTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@{String.valueOf(isActive)}"
                app:layout_constraintStart_toEndOf="@+id/labelActive"
                app:layout_constraintTop_toBottomOf="@+id/buttonWipe"
                tools:text="true" />

            <TextView
                android:id="@+id/labelPaused"
                style="@style/TextInputTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:visibility="gone"
                android:text="isPaused: "
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/labelActive"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/textPaused"
                style="@style/TextInputTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@{String.valueOf(isPaused)}"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@+id/labelPaused"
                app:layout_constraintTop_toBottomOf="@+id/labelActive"
                tools:text="false" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/textPaused" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_medium"
                android:backgroundTint="@android:color/white"
                android:src="@drawable/ic_no_gps"
                app:borderWidth="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/fab_settings"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_medium"
                android:backgroundTint="@android:color/white"
                android:src="@drawable/ic_settings_gray"
                app:borderWidth="0dp"
                app:layout_constraintBottom_toTopOf="@+id/fab_location"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_medium"
                android:backgroundTint="@android:color/white"
                android:src="@drawable/ic_map_current_location"
                app:borderWidth="0dp"
                app:layout_constraintBottom_toTopOf="@+id/fab_close"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_large"
                android:layout_marginBottom="64dp"
                android:backgroundTint="@android:color/white"
                android:src="@drawable/ic_close"
                app:borderWidth="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/sendingResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_large"
                android:layout_marginBottom="64dp"
                android:background="@android:color/white"
                android:backgroundTint="@android:color/white"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:padding="8dp"
                >

                <androidx.core.widget.ContentLoadingProgressBar
                    android:id="@+id/progressStatistics"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="24dp"
                    android:layout_gravity="center"
                    android:layout_height="24dp"
                    android:indeterminateTint="@color/colorAccent"
                    />
                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sending_results"
                    />

            </LinearLayout>

            <TextView
                android:id="@+id/labelSource"
                style="@style/TextInputTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_large"
                android:text="@string/location_dialog_label_source"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/textSource"
                style="@style/TextInputTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_large"
                android:text=" - "
                app:layout_constraintStart_toEndOf="@+id/labelSource"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="true"
                android:visibility="gone"
                tools:ignore="HardcodedText" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/warning_message"
                android:layout_width="match_parent"
                android:background="@drawable/dialog_background"
                android:padding="@dimen/margin_large"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/warning_message_title"
                    style="@style/RobotoBoldStyle.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/colorAccent"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_large"
                    android:text="@string/open_gps_setting_dialog_label_gps_not_enabled"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/warning_message_content"
                    style="@style/RobotoRegularStyle.Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingTop="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_small"
                    android:paddingBottom="@dimen/padding_large"
                    android:text="@string/open_gps_setting_dialog_label_gps_not_enabled"
                    android:textColor="@color/text_black_transparency_60"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/warning_message_title" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/warning_message_action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_green_background"
                    android:text="@string/open_gps_setting_dialog_label_open_gps_setting"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/warning_message_content" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/warning_message_cancel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_white_background"
                    android:elevation="0dp"
                    android:text="@string/open_gps_setting_dialog_label_cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/colorAccent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/warning_message_action" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>