<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="title"
            type="String" />

        <variable
            name="summary"
            type="String" />

    </data>

    <LinearLayout
        android:id="@+id/frameLayoutRootSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_large"
        android:paddingEnd="@dimen/padding_large"
        android:paddingTop="@dimen/padding_large"
        android:paddingBottom="@dimen/padding_medium">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/titleTVISS"
                style="@style/RobotoRegularStyle.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:singleLine="true"
                android:text="@{title}"
                android:textColor="@color/text_dark_gray"
                tools:text="Signal GPS accuracy limit" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/sliderValueTVISS"
                style="@style/RobotoRegularStyle.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/colorAccent"
                tools:text="14 m" />

        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/summaryTVISS"
            style="@style/RobotoRegularStyle.VerySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@{summary}"
            app:visibleOrGone="@{summary != null}"
            tools:text="Overrides the default accuracy threshold" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderISS"
            android:theme="@style/Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="1"
            android:valueTo="100" />

    </LinearLayout>

</layout>
